set(prefix "@CMAKE_BINARY_DIR@/runtime-config-prefix")
set(work "@CMAKE_BINARY_DIR@/runtime-config-integration")
file(REMOVE_RECURSE "${prefix}" "${work}")
execute_process(
  COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_BINARY_DIR@" --prefix "${prefix}"
  RESULT_VARIABLE install_result
)
if(NOT install_result EQUAL 0)
  message(FATAL_ERROR "runtime configuration integration install failed")
endif()
execute_process(
  COMMAND bash "@CMAKE_CURRENT_SOURCE_DIR@/tests/native_runtime_config_test.sh" "${work}"
    "${prefix}/bin/container-tools" "@CMAKE_BINARY_DIR@/test_runtime_child"
    "@CMAKE_BINARY_DIR@/test_buildx_child"
    "@CMAKE_BINARY_DIR@/test_storage_timeout_child"
  RESULT_VARIABLE test_result
)
if(NOT test_result EQUAL 0)
  message(FATAL_ERROR "runtime configuration integration failed")
endif()
