string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef work_suffix)
set(work "/tmp/mkchad-v1/container-tools-runtime-boundary/runtime-config-${work_suffix}")
execute_process(
  COMMAND bash "@CMAKE_CURRENT_SOURCE_DIR@/tests/native_runtime_config_test.sh" "${work}"
    "@CMAKE_BINARY_DIR@/container-tools"
  RESULT_VARIABLE test_result
)
file(REMOVE_RECURSE "${work}")
if(NOT test_result EQUAL 0)
  message(FATAL_ERROR "runtime configuration integration failed")
endif()
