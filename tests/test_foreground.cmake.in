set(prefix "@CMAKE_BINARY_DIR@/foreground-prefix")
set(work "/tmp/mkchad-v1/container-tools-c11/foreground-integration")
file(REMOVE_RECURSE "${prefix}" "${work}")
execute_process(COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_BINARY_DIR@" --prefix "${prefix}" RESULT_VARIABLE install_result)
if(NOT install_result EQUAL 0)
  message(FATAL_ERROR "foreground integration install failed")
endif()
execute_process(COMMAND bash "@CMAKE_CURRENT_SOURCE_DIR@/tests/native_foreground_test.sh" "${work}" "${prefix}/bin/container-tools" RESULT_VARIABLE test_result)
if(NOT test_result EQUAL 0)
  message(FATAL_ERROR "native foreground integration failed")
endif()
